# Copy to .env and fill in values. Never commit .env.
# Local development. In production DJANGO_DEBUG defaults to false and a real secret is required.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Free key from https://developer.tomtom.com
TOMTOM_API_KEY=

# Optional: share the cache across processes/instances, e.g. redis://localhost:6379/0
# REDIS_URL=
